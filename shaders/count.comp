#version 430

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Positions {
    vec2 positions[];
};

layout(std430, binding = 4) buffer CellCounts {
    uint cell_counts[];
};

uniform uint u_num_particles;
uniform vec2 u_grid_origin;   // bottom-left corner of the domain
uniform float u_cell_size;    // = KERNEL_RADIUS, so 3x3 cells cover the kernel
uniform int u_grid_w;
uniform int u_grid_h;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= u_num_particles) return;

    ivec2 cell = ivec2(floor((positions[i] - u_grid_origin) / u_cell_size));
    cell = clamp(cell, ivec2(0), ivec2(u_grid_w - 1, u_grid_h - 1));
    uint cell_index = uint(cell.y * u_grid_w + cell.x);

    atomicAdd(cell_counts[cell_index], 1u);
}
