// Places each particle's index into its cell's run of sorted_indices.
// cell_cursors starts as a copy of cell_starts; atomicAdd hands out slots.
#version 430

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Positions {
    vec2 positions[];
};

layout(std430, binding = 6) buffer CellCursors {
    uint cell_cursors[];
};

layout(std430, binding = 7) buffer SortedIndices {
    uint sorted_indices[];
};

uniform uint u_num_particles;
uniform vec2 u_grid_origin;
uniform float u_cell_size;
uniform int u_grid_w;
uniform int u_grid_h;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= u_num_particles) return;

    ivec2 cell = ivec2(floor((positions[i] - u_grid_origin) / u_cell_size));
    cell = clamp(cell, ivec2(0), ivec2(u_grid_w - 1, u_grid_h - 1));
    uint cell_index = uint(cell.y * u_grid_w + cell.x);

    uint slot = atomicAdd(cell_cursors[cell_index], 1u);
    sorted_indices[slot] = i;
}
