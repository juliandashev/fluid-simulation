#version 430

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Positions {
    vec2 positions[];
};

layout(std430, binding = 1) buffer Velocities {
    vec2 velocities[];
};

uniform float u_dt;
uniform float u_gravity;
uniform uint u_num_particles;
uniform float u_domain_half_x;   // x bound
uniform float u_domain_min;      // y bounds
uniform float u_domain_max;
uniform float u_bounce_damping;
uniform float u_eps;
uniform float u_max_speed;

layout(std430, binding = 3) buffer Accelerations {
    vec2 accelerations[];
};

layout(std430, binding = 8) buffer Speeds {
    float speeds[];
};

layout(std430, binding = 10) buffer MidVelocities {
    vec2 mid_velocities[];
};

// Reflect one particle back inside one face. `inward` is +1 when the fluid lies
// on the increasing side of `bound`. Capped at u_eps; reflection is unbounded.
void reflect_face(inout float coord, inout float vel, float bound, float inward) {
    float penetration = (bound - coord) * inward;
    if (penetration > 0.0) {
        coord = bound + inward * min(penetration, u_eps);
        vel *= u_bounce_damping;
    }
}

// RK2 final advance: velocity kicks with the midpoint acceleration
// (accelerations holds a2 by now), position moves with the midpoint velocity.
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= u_num_particles) return;

    vec2 position = positions[i];
    vec2 velocity = velocities[i];

    velocity += (vec2(0.0, u_gravity) + accelerations[i]) * u_dt;
    position += mid_velocities[i] * u_dt;

    // A NaN position never un-NaNs (comparisons below are all false for it)
    // and zeroes its density, spraying inf at every neighbor - rescue it.
    if (isnan(position.x) || isnan(position.y)) {
        position = vec2(0.0);
        velocity = vec2(0.0);
    }

    reflect_face(position.x, velocity.x, -u_domain_half_x,  1.0);
    reflect_face(position.x, velocity.x,  u_domain_half_x, -1.0);
    reflect_face(position.y, velocity.y,  u_domain_min,     1.0);
    reflect_face(position.y, velocity.y,  u_domain_max,    -1.0);

    // Hard cap, not physics: stops a force spike snowballing into NaN.
    float speed = length(velocity);
    if (isnan(speed) || isinf(speed)) {
        velocity = vec2(0.0);          // particle survives, loses momentum
        speed = 0.0;
    } else if (speed > u_max_speed) {
        velocity *= u_max_speed / speed;
        speed = u_max_speed;
    }

    speeds[i] = speed;
    positions[i] = position;
    velocities[i] = velocity;
}
