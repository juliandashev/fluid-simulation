#version 430

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Positions {
    vec2 positions[];
};

layout(std430, binding = 1) buffer Velocities {
    vec2 velocities[];
};

uniform float u_dt;
uniform float u_gravity;
uniform uint u_num_particles;
uniform float u_domain_half_x;   // x bound
uniform float u_domain_min;      // y bounds
uniform float u_domain_max;
uniform float u_bounce_damping;
uniform float u_eps;
uniform float u_max_speed;

layout(std430, binding = 3) buffer Accelerations {
    vec2 accelerations[];
};

layout(std430, binding = 8) buffer Speeds {
    float speeds[];
};

layout(std430, binding = 10) buffer MidVelocities {
    vec2 mid_velocities[];
};

// RK2 final advance: velocity kicks with the midpoint acceleration
// (accelerations holds a2 by now), position moves with the midpoint velocity.
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= u_num_particles) return;

    vec2 position = positions[i];
    vec2 velocity = velocities[i];

    velocity += (vec2(0.0, u_gravity) + accelerations[i]) * u_dt;
    position += mid_velocities[i] * u_dt;

    if (position.x < -u_domain_half_x + u_eps) {
        position.x = -u_domain_half_x + u_eps;
        velocity.x *= u_bounce_damping;
    } else if (position.x > u_domain_half_x - u_eps) {
        position.x = u_domain_half_x - u_eps;
        velocity.x *= u_bounce_damping;
    }

    if (position.y < u_domain_min) {
        position.y = u_domain_min;
        velocity.y *= u_bounce_damping;
    } else if (position.y > u_domain_max) {
        position.y = u_domain_max;
        velocity.y *= u_bounce_damping;
    }

    // Hard cap, not physics: no single bad substep can launch a particle
    // toward infinity, so a force spike can never snowball into NaN. The
    // CFL-adapted dt catches up a frame later and restores accuracy.
    float speed = length(velocity);
    if (speed > u_max_speed) {
        velocity *= u_max_speed / speed;
        speed = u_max_speed;
    }

    speeds[i] = speed;
    positions[i] = position;
    velocities[i] = velocity;
}
